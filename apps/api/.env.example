# Copy this file to apps/api/.env and fill in the values. Git ignores .env, so secrets stay on
# your machine. Never paste these values into chat, issues or commits.

# Supabase database, from the dashboard: Connect > Session pooler. Copy the whole string (the host
# may differ from this example), then replace [YOUR-PASSWORD] with the database password.
# Don't add "?sslmode=..." to the end; the CA file below handles TLS.
DATABASE_URL=postgresql://postgres.lscshfcspvrrgktiotju:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase's CA certificate, from Database settings > SSL Configuration > Download certificate.
# The path is relative to apps/api. With it, the connection is encrypted and Supabase is verified.
DATABASE_CA_FILE=./certs/supabase-ca.crt

# Snapshot storage. The URL is the project URL; the key is a secret key from
# Project Settings > API Keys (starts with sb_secret_). Server only: never put it in the web app.
SUPABASE_URL=https://lscshfcspvrrgktiotju.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The inference service's shared secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DETECTOR_TOKEN=

# Local development runs over plain HTTP, so session cookies can't require HTTPS here.
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3000
