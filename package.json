{
  "name": "bantaybuhay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run build -w @bantaybuhay/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @bantaybuhay/shared && npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @bantaybuhay/api",
    "dev:web": "npm run dev -w @bantaybuhay/web",
    "test:db": "node scripts/test-db.mjs start",
    "test:db:stop": "node scripts/test-db.mjs stop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
