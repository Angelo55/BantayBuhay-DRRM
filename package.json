{
  "name": "bantaybuhay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:all": "concurrently --kill-others-on-fail --names api,web,detect --prefix-colors cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:inference\"",
    "dev:api": "npm run dev -w @bantaybuhay/api",
    "dev:web": "npm run dev -w @bantaybuhay/web",
    "dev:inference": "node scripts/run-inference.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "db:check": "npm run db:check -w @bantaybuhay/api",
    "db:seed": "npm run db:seed -w @bantaybuhay/api",
    "accounts": "node scripts/accounts.mjs",
    "deploy:secrets": "node scripts/deploy-secrets.mjs",
    "check:roles": "npm run check:roles -w @bantaybuhay/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run build -w @bantaybuhay/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @bantaybuhay/shared && npm run test --workspaces --if-present",
    "test:local": "node scripts/test-db.mjs run",
    "test:db": "node scripts/test-db.mjs start",
    "test:db:stop": "node scripts/test-db.mjs stop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
