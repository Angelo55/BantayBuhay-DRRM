{
  // Common BantayBuhay commands. Run them from Terminal > Run Task..., or Ctrl+Shift+P > "Tasks: Run Task".
  // Each runs in VS Code's terminal, in this project folder.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start app (API + web)",
      "detail": "Opens on http://127.0.0.1:5173. Stop with Ctrl+C in its terminal",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start app with the detector",
      "detail": "API, web and the camera detector (1 camera at 1 fps on a laptop)",
      "type": "npm",
      "script": "dev:all",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Stop app",
      "detail": "Stops any BantayBuhay server still running on ports 3000, 5173 or 8000",
      "type": "npm",
      "script": "stop",
      "problemMatcher": []
    },
    {
      "label": "Setup (fresh clone)",
      "detail": "Run npm install first. Prepares Python, the model and the test database",
      "type": "npm",
      "script": "setup",
      "problemMatcher": []
    },
    {
      "label": "Test everything (local database)",
      "detail": "Starts the test database, runs every test, then stops it",
      "type": "npm",
      "script": "test:local",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Show test accounts",
      "detail": "Lists the seeded accounts with their passwords, from seed-credentials.local.json",
      "type": "npm",
      "script": "accounts",
      "problemMatcher": []
    },
    {
      "label": "Check every role (app must be running)",
      "detail": "Signs in as each seeded role and checks what it can and can't reach",
      "type": "npm",
      "script": "check:roles",
      "problemMatcher": []
    },
    {
      "label": "Seed test accounts (empty database only)",
      "detail": "Creates the 20 fictional accounts and 6 cameras; passwords go to seed-credentials.local.json",
      "type": "npm",
      "script": "db:seed",
      "problemMatcher": []
    },
    {
      "label": "Check Supabase connection",
      "detail": "Checks the settings in apps/api/.env against Supabase",
      "type": "npm",
      "script": "db:check",
      "problemMatcher": []
    },
    {
      "label": "Check Supabase migrations",
      "detail": "Lists files in supabase/migrations that Supabase hasn't applied; changes nothing",
      "type": "npm",
      "script": "db:migrate",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Start test database",
      "detail": "Leaves it running until you stop it, for running single tests",
      "type": "npm",
      "script": "test:db",
      "problemMatcher": []
    },
    {
      "label": "Stop test database",
      "type": "npm",
      "script": "test:db:stop",
      "problemMatcher": []
    }
  ]
}
