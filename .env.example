# infra/smoke.sh creates .env from this file with random passwords.
# Use only letters and digits, because these go into connection URLs.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Where nginx listens. Local default: 127.0.0.1:8080
HTTP_BIND=127.0.0.1:8080

# Local HTTP only. Deployed servers use HTTPS and must set this to true.
COOKIE_SECURE=false
