# Copy to services/inference/.env to change these. Every line is optional.
# The detector token is read from apps/api/.env, so it isn't repeated here.

# Where the API listens.
API_URL=http://127.0.0.1:3000

# Folder of camera clips, named after each camera: barangay-1.mp4, binicuil.mp4, tagukon.mp4,
# hilamonan.mp4, tampalon.mp4, camansi.mp4. A camera without a clip shows a moving test pattern.
# Relative paths start from services/inference.
VIDEO_DIR=../../media/sim

# Laptop-friendly defaults: detection is CPU-heavy (six cameras at 2 fps use 4 to 5 cores).
# The demo server runs all cameras at 2 fps.
CAMERA_LIMIT=1
FRAMES_PER_SECOND=1

# The detection model, downloaded and checked by npm run setup.
MODEL_PATH=models/dfine_n_coco.onnx
